# 车上配置。安装脚本只在 /home/guide/CLionProjects/GNSS/config/system.yaml 不存在时复制本文件，升级不会覆盖。
# 把 CHANGE_ME 换成机房 Windows 的局域网 IP。MQTT 账号与 mosquitto/passwd、后端 .env 相同。

backend:
  api_base_url: http://CHANGE_ME:8000
  host: CHANGE_ME
  port: 8000
  timeout_s: 10

mqtt:
  broker_host: CHANGE_ME
  broker_port: 1883
  keepalive: 60
  username: rtg_user
  password: ''
  qos_control: 1
  qos_status: 1
  qos_telemetry: 0

vehicle_id: RTG-001

gnss:
  offline_timeout_s: 2.0
  raw_log:
    dir: /home/guide/CLionProjects/GNSS/state/gnss_raw
    echo_console: false
    enabled: true
    session_gap_s: 2.0
  receiver_a1:
    host: 192.168.8.172
    port: 30001
    reconnect_interval_s: 3
    role: gantry_a1
    transport: tcp
  receiver_a2:
    host: 0.0.0.0
    port: 9002
    reconnect_interval_s: 3
    role: gantry_a2
    transport: udp
  receiver_b:
    host: 0.0.0.0
    port: 9003
    role: trolley
    transport: udp

logging:
  backup_count: 5
  file: /home/guide/CLionProjects/GNSS/logs/rtg.log
  level: INFO
  max_bytes: 10485760
  position_log_interval_s: 1.0

plc:
  enabled: false
  frame_rate_hz: 10
  host: 127.0.0.1
  port: 5000
  reconnect_interval_s: 3

yard_backup:
  path: /home/guide/CLionProjects/GNSS/state/yard_config.yaml
yard_map:
  path: /home/guide/CLionProjects/GNSS/state/yard_map.json
