[Unit]
Description=RTG onboard controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guide
Group=guide
WorkingDirectory=/home/guide/CLionProjects/GNSS/current
Environment=RTG_CONFIG_DIR=/home/guide/CLionProjects/GNSS/config
Environment=RTG_STATE_DIR=/home/guide/CLionProjects/GNSS/state
ExecStart=/home/guide/CLionProjects/GNSS/current/.venv/bin/python -m src.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
